# Copy to .env and fill in. Never commit .env.
#
# WHAT REACHES THE BROWSER: only SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY and the
# VITE_-prefixed names below. vite-plugins/publicEnv.ts enforces that with an
# allowlist, and `npm run check:secrets` fails the build if anything else does.

# ---------------------------------------------------------------- Supabase
SUPABASE_URL=https://<project-ref>.supabase.co

# Safe in the browser. Row-level security is what protects the data, not this key.
SUPABASE_PUBLISHABLE_KEY=

# SERVER AND SCRIPTS ONLY. Bypasses row-level security — never ship it.
SUPABASE_SECRET_KEY=

# Migrations (`npm run db:migrate`). Use the SESSION POOLER host: the direct
# db.<ref>.supabase.co host resolves to IPv6 only and will not connect from
# most networks.
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_PASSWORD=

# Optional: lets `node scripts/auth-config.mjs` change auth settings for you.
# SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------- models
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_APP_NAME=BIMCAD Studio
VITE_OPENROUTER_TEXT_MODEL=
VITE_OPENROUTER_VISION_MODEL=
VITE_OPENROUTER_JUDGE_MODEL=
